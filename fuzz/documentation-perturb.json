{
  "cwd": ".",
  "command": ["cargo", "+nightly", "test", "--manifest-path", "fuzz/Cargo.toml", "--locked", "--lib", "--no-fail-fast"],
  "cases": [
    {
      "name": "swap-rust-python-tags",
      "file": "fuzz/src/documentation/header.rs",
      "old": "    LANG::Rust,\n    LANG::Python,",
      "new": "    LANG::Python,\n    LANG::Rust,",
      "expect": ["documentation::tests::registry_executes_every_dispatch_and_edge_assertion"]
    },
    {
      "name": "skip-source-at-inclusive-cap",
      "file": "fuzz/src/documentation/mod.rs",
      "old": "if input.source.len() > MAX_SOURCE {",
      "new": "if input.source.len() >= MAX_SOURCE {",
      "expect": ["documentation::tests::header_roster_skips_and_resource_boundaries_are_explicit"]
    },
    {
      "name": "reject-stored-scalar-split",
      "file": "fuzz/src/documentation/maps.rs",
      "old": "range.start == end && range.start < range.end && range.end <= complete.text().len(),",
      "new": "range.start == end && range.start < range.end && range.end <= complete.text().len() && complete.text().is_char_boundary(range.end),",
      "expect": ["documentation::tests::registry_executes_every_dispatch_and_edge_assertion"]
    },
    {
      "name": "lose-deferred-profile-distinction",
      "file": "fuzz/src/documentation/header.rs",
      "old": "Err(CollectionError::AdapterUnavailable { language, profile })",
      "new": "Err(CollectionError::UnsupportedProfile { language, profile })",
      "expect": ["documentation::tests::registry_executes_every_dispatch_and_edge_assertion"]
    },
    {
      "name": "lose-qualified-candidate-identity",
      "file": "fuzz/src/documentation/tests.rs",
      "old": "                    assert_eq!(\n                        index.qualified_owner(qualification).unwrap(),\n                        Some(owner),\n                        \"candidate owner identity\"\n                    );",
      "new": "                    let _ = owner;\n                    assert!(index.qualified_owner(qualification).unwrap().is_some());",
      "expect": ["documentation::tests::qualification_oracle_rejects_same_reasons_on_the_wrong_candidate"]
    },
    {
      "name": "attribute-local-pending-to-leading-document",
      "file": "fuzz/src/documentation/tests.rs",
      "old": "&& index.assessed_document(a).unwrap() == Some(local))",
      "new": "&& index.assessed_document(a).unwrap() == index.documents().next())",
      "expect": ["documentation::tests::registry_executes_every_dispatch_and_edge_assertion"]
    },
    {
      "name": "decode-without-repeat",
      "file": "fuzz/src/documentation/header.rs",
      "old": "repeat: mode & 1 != 0,",
      "new": "repeat: false,",
      "expect": ["documentation::tests::remediation::decoder_mode_table_is_independent", "documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "decode-without-identity",
      "file": "fuzz/src/documentation/header.rs",
      "old": "identity: mode & 2 != 0,",
      "new": "identity: false,",
      "expect": ["documentation::tests::remediation::decoder_mode_table_is_independent", "documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "decode-cancel-as-raw",
      "file": "fuzz/src/documentation/header.rs",
      "old": "2 => Mode::CancelledScope,",
      "new": "2 => Mode::Raw,",
      "expect": ["documentation::tests::remediation::decoder_mode_table_is_independent", "documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "decode-active-as-raw",
      "file": "fuzz/src/documentation/header.rs",
      "old": "_ => Mode::ActiveScope,",
      "new": "_ => Mode::Raw,",
      "expect": ["documentation::tests::remediation::decoder_mode_table_is_independent", "documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "bypass-repeat-operation",
      "file": "fuzz/src/documentation/mod.rs",
      "old": "if repeat {",
      "new": "if repeat && false {",
      "expect": ["documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "bypass-identity-operation",
      "file": "fuzz/src/documentation/mod.rs",
      "old": "if identity {",
      "new": "if identity && false {",
      "expect": ["documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "bypass-cancel-operation",
      "file": "fuzz/src/documentation/mod.rs",
      "old": "if input.mode == Mode::CancelledScope {",
      "new": "if input.mode == Mode::CancelledScope && false {",
      "expect": ["documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "remove-active-scope-installation",
      "file": "fuzz/src/documentation/mod.rs",
      "old": "flag.run(|| {\n            let outcome = check()?;\n            #[cfg(test)]\n            observation::active_witness(&flag, &parsed, input.options)?;\n            Ok(outcome)\n        })",
      "new": "{\n            let outcome = check()?;\n            #[cfg(test)]\n            observation::active_witness(&flag, &parsed, input.options)?;\n            Ok(outcome)\n        }",
      "expect": ["documentation::tests::remediation::mode_calls_and_active_scope_are_observed"]
    },
    {
      "name": "wrong-candidate-resolution-setup",
      "file": "big-code-analysis-ast/src/documentation/collector.rs",
      "old": "    Ok(builder.index)\n}",
      "new": "    for association in &mut builder.index.facts.associations {\n        if association.resolution == Resolution::Unresolved(UnresolvedReason::Ambiguous) {\n            association.resolution = Resolution::Resolved;\n        }\n    }\n    Ok(builder.index)\n}",
      "expect": ["documentation::tests::qualification_oracle_rejects_same_reasons_on_the_wrong_candidate", "documentation::tests::registry_executes_every_dispatch_and_edge_assertion"]
    }
  ]
}
