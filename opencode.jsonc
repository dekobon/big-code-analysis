{
  "$schema": "https://opencode.ai/config.json",
  // AGENTS.md is discovered automatically. The bca-check plugin loads
  // by discovery from .opencode/plugins/; "plugins" takes packages and
  // directories, not a single file.
  //
  // The rules below are guardrails against command spellings, not
  // enforcement of the policy in AGENTS.md: `git -C … push` or a
  // filesystem removal of a worktree directory are not matched. The
  // worktree denials apply to orchestrators too; a skill that created
  // worktrees lists them and asks the user to remove them
  // (docs/development/agent_isolation.md).
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove *", "effect": "deny" },
    { "action": "shell", "resource": "git worktree prune *", "effect": "deny" }
  ]
}
