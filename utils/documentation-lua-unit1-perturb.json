      "old": "            draft.target = Some(NodeId(0));\n            draft.role = DocumentRole::FilePackage;\n            draft.binding = None;",
      "new": "            draft.role = DocumentRole::FilePackage;\n            draft.binding = None;",
      "expect": [
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file",
        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
    {
      "name": "lua-file-document-has-primary-role",
      "file": "big-code-analysis-ast/src/documentation/collector.rs",
      "old": "            draft.role = DocumentRole::FilePackage;\n            draft.binding = None;",
      "new": "            draft.binding = None;",
      "expect": [
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file",
        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
