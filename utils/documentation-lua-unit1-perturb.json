      "old": "    Ok(s.starts_with(b\"---\") && !ldoc_end_marker(s, budget)?)",
      "new": "    Ok(s.starts_with(b\"--\") && !ldoc_end_marker(s, budget)?)",
      "expect": [
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_plain_comments_give_no_document",
        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file"
      ]
    },
    {
      "name": "ldoc-plain-long-comment-opens-a-block",
      "file": "big-code-analysis-ast/src/lang_helpers/doc_text.rs",
      "old": "        return Ok(body.first() == Some(&b'-'));",
      "new": "        return Ok(body.first() != Some(&b'+'));",
      "expect": [
