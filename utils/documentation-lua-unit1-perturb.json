        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file",
        "documentation::collector::lua_tests::lua_blank_row_separates_two_blocks"
      ]
    },
    {
      "name": "lua-long-comment-does-not-end-run",
      "file": "big-code-analysis-ast/src/documentation/recognition.rs",
      "old": "                budget,\n            )\n        } else {\n            PublicRules::<T>::ends(node, code, budget)",
      "new": "                budget,\n            )\n            .map(|_| false)\n        } else {\n            PublicRules::<T>::ends(node, code, budget)",
      "expect": [
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file"
      ]
    },
    {
      "name": "ldoc-line-marker-two-bytes",
      "file": "big-code-analysis-ast/src/documentation/text/comments.rs",
      "old": "        let mut prefix = 2;\n        while raw.get(prefix) == Some(&b'-') {",
      "new": "        let mut prefix = 2;\n        while raw.get(prefix) == Some(&b'+') {",
      "expect": [
        "documentation::collector::lua_tests::lua_marked_block_above_a_function_documents_the_function",
        "documentation::collector::lua_tests::lua_marked_block_above_an_assignment_has_its_owner",
        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file",
        "documentation::collector::lua_tests::lua_blank_row_separates_two_blocks",
