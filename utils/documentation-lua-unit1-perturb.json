{
  "cwd": ".",
  "runner": "cargo",
  "cargo": [
    "cargo",
    "test",
    "-p",
    "big-code-analysis-ast",
    "--all-features",
    "--lib",
    "documentation::"
  ],
  "cases": [
    {
      "name": "lua-positional-docs-off",
      "file": "big-code-analysis-ast/src/checker/lua.rs",
      "old": "    const SOURCE_POSITIONAL_DOCS: bool = true;",
      "new": "    const SOURCE_POSITIONAL_DOCS: bool = false;",
      "expect": [
        "documentation::collector::lua_tests::lua_marked_block_above_a_function_documents_the_function",
        "documentation::collector::lua_tests::lua_marked_block_above_an_assignment_has_its_owner",
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_plain_comments_give_no_document",
        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file",
        "documentation::collector::lua_tests::lua_blank_row_separates_two_blocks",
        "documentation::collector::lua_tests::lua_rows_of_a_run_compose_one_document",
        "documentation::collector::lua_tests::lua_text_cleanup_removes_the_marker_and_at_most_one_space",
        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
    {
      "name": "lua-function-not-a-source-item",
      "file": "big-code-analysis-ast/src/roles/lua.rs",
      "old": "        _ => Ok(true),",
