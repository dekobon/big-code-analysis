        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
    {
      "name": "first-line-space-kept",
      "file": "big-code-analysis-ast/src/documentation/text/comments.rs",
      "old": "            lines[0].content.start += 1;\n",
      "new": "            lines[0].content.start += 0;\n",
      "expect": [
        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file",
        "documentation::collector::lua_tests::lua_rows_of_a_run_compose_one_document",
        "documentation::collector::lua_tests::lua_text_cleanup_removes_the_marker_and_at_most_one_space",
        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
    {
      "name": "ldoc-long-level-ignored",
      "file": "big-code-analysis-ast/src/documentation/text/comments.rs",
      "old": "            let close = equals - 1;",
      "new": "            let close = 2;",
      "expect": [
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_text_cleanup_removes_the_marker_and_at_most_one_space"
      ]
    },
    {
      "name": "ldoc-long-dashes-kept",
      "file": "big-code-analysis-ast/src/documentation/text/comments.rs",
      "old": "            let mut prefix = equals + 1;\n            while raw.get(prefix) == Some(&b'-') {",
      "new": "            let mut prefix = equals + 1;\n            while raw.get(prefix) == Some(&b'+') {",
      "expect": [
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_text_cleanup_removes_the_marker_and_at_most_one_space",
        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
    {
      "name": "crlf-in-block-copied-raw",
      "file": "big-code-analysis-ast/src/documentation/text/source_cursor.rs",
      "old": "        if range.len() == 2 {",
      "new": "        if range.len() == 3 {",
      "expect": [
        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
    {
      "name": "lua-every-block-is-tagged",
      "file": "big-code-analysis-ast/src/checker/lua.rs",
      "old": "    if text.tag {\n        return Ok(Ok(Some(OpenerReason::Tagged)));",
      "new": "    if text.text {\n        return Ok(Ok(Some(OpenerReason::Tagged)));",
      "expect": [
        "documentation::collector::lua_tests::lua_blank_row_separates_two_blocks",
        "documentation::collector::lua_tests::lua_long_bracket_block_is_one_fragment_and_ends_its_run",
        "documentation::collector::lua_tests::lua_unit2_local_and_return_owners_and_unrecognized_controls",
        "documentation::streaming::positional::tests::lua_plain_marked_first_file_and_later_contexts"
