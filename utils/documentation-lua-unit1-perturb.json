        "documentation::collector::lua_tests::lua_first_block_of_a_file_documents_the_file",
        "documentation::collector::lua_tests::lua_blank_row_separates_two_blocks",
        "documentation::collector::lua_tests::lua_rows_of_a_run_compose_one_document",
        "documentation::collector::lua_tests::lua_text_cleanup_removes_the_marker_and_at_most_one_space",
        "documentation::collector::lua_tests::lua_crlf_rows_keep_owners_fragments_and_text"
      ]
    },
    {
      "name": "lua-assignment-not-a-source-item",
      "file": "big-code-analysis-ast/src/roles/lua.rs",
      "old": "        Lua::AssignmentStatement | Lua::AssignmentStatement2 => {\n            assigns_one_name_with_budget(node, budget)\n        }",
      "new": "        Lua::AssignmentStatement | Lua::AssignmentStatement2 => {\n            assigns_one_name_with_budget(node, budget).map(|_| false)\n        }",
      "expect": [
        "documentation::collector::lua_tests::lua_marked_block_above_an_assignment_has_its_owner"
      ]
    },
    {
      "name": "ldoc-two-dashes-open-a-block",
