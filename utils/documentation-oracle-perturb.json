{
  "description": "Run from the repository root with python3 -B utils/perturb.py utils/documentation-oracle-perturb.json. Targets must be tracked and clean. Rust companion: documentation-oracle-rust-perturb.json.",
  "cwd": ".",
  "runner": "unittest",
  "command": [
    "python3", "-B", "-m", "unittest", "-q",
    "utils/drift-oracle-test.py", "utils/drift-compare-test.py"
  ],
  "cases": [
    {
      "name": "drop-cli-metric-options",
      "file": "utils/drift-oracle.py",
      "old": "[*base, \"metrics\", \"-O\", \"json\", *extra, *tail]",
      "new": "[*base, \"metrics\", \"-O\", \"json\", *tail]",
      "expect": ["utils.drift-oracle-test.DriftOracleTests.test_mi_matrix_and_every_argv_are_symmetric_and_explicit"]
    },
    {
      "name": "drop-verbatim-metric-options",
      "file": "utils/drift-oracle.py",
      "old": "[str(args.verbatim), *extra, lang, path_arg]",
      "new": "[str(args.verbatim), lang, path_arg]",
      "expect": [
        "utils.drift-oracle-test.DriftOracleTests.test_mi_matrix_and_every_argv_are_symmetric_and_explicit",
        "utils.drift-oracle-test.DriftOracleTests.test_a_failed_mi_verbatim_view_is_not_a_baseline"
      ]
    },
    {
      "name": "accept-empty-key-sets",
      "file": "utils/drift-compare.py",
      "old": "    if not kb or not kh:\n        print(\"no keys on one side; nothing compared\")\n        return 2\n",
      "new": "",
      "expect": ["utils.drift-compare-test.DriftCompareTests.test_empty_key_sets_are_refused_even_without_a_filter"]
    }
  ]
}
