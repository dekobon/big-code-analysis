{
  "cwd": ".",
  "runner": "cargo",
  "cargo": [
    "cargo",
    "test",
    "-p",
    "big-code-analysis",
    "--all-features",
    "--lib",
    "documentation_ruby_unit2_legacy_rows_stay_in_place"
  ],
  "cases": [
    {
      "name": "ruby-legacy-document-row-removed",
      "file": "src/metrics/loc/shared.rs",
      "old": "            stats.dloc.lines.insert_range(first, last);",
      "new": "            let _ = (first, last);",
      "expect": [
        "metrics::loc::documentation_tests::documentation_ruby_unit2_legacy_rows_stay_in_place"
      ]
    },
    {
      "name": "ruby-legacy-document-rows-shifted",
      "file": "src/metrics/loc/shared.rs",
      "old": "            stats.dloc.lines.insert_range(first, last);",
      "new": "            stats.dloc.lines.insert_range(first.saturating_sub(1), last.saturating_sub(1));",
      "expect": [
        "metrics::loc::documentation_tests::documentation_ruby_unit2_legacy_rows_stay_in_place"
      ]
    },
    {
      "name": "ruby-legacy-visits-disabled",
      "file": "big-code-analysis-ast/src/observation.rs",
      "old": "                COUNT.with(|count| count.set(count.get() + 1));",
      "new": "                COUNT.with(|count| count.set(count.get()));",
      "expect": [
        "metrics::loc::documentation_tests::documentation_ruby_unit2_legacy_rows_stay_in_place"
      ]
    }
  ]
}
