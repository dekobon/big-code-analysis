"```toml\n"
"[dependencies]\n"
"big-code-analysis = { version = \"2.0.0\", default-features = false, "
"features = [\"rust\", \"typescript\"] }\n"
"```"
msgstr ""
"```toml\n"
"[dependencies]\n"
"big-code-analysis = { version = \"2.0.0\", default-features = false, "
"features = [\"rust\", \"typescript\"] }\n"
"```"

